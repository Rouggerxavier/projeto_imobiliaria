PORT=8000
LOG_LEVEL=info
APP_ENV=production

# === LLM CONFIG ===
# Usando API NATIVA do Gemini (NÃO o endpoint OpenAI bugado!)

# Google Gemini - API Nativa ⭐
OPENAI_API_KEY=SUA_CHAVE_AQUI
OPENAI_MODEL=gemini-2.5-flash
OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/

# LLM habilitado? (true=usa LLM, false=só fallback)
USE_LLM=true

# Timeout da chamada LLM (segundos)
LLM_TIMEOUT=120

# === LLM LOCAL (Ollama) - Opcional ===
LLM_KEEP_ALIVE=30m
LLM_NUM_CTX=2048
LLM_NUM_THREADS=8
LLM_USE_MMAP=true
LLM_PREWARM=false

# === WHATSAPP CONFIG ===
WHATSAPP_VERIFY_TOKEN=ESCOLHA_UM_TOKEN_SECRETO
WHATSAPP_APP_SECRET=
WHATSAPP_PHONE_NUMBER_ID=
ID_CONTA_WPP_BUSINESS=
WHATSAPP_ACCESS_TOKEN=
DISABLE_WHATSAPP_SEND=true

# === SEGURANÇA ===
# Chave de acesso ao endpoint /webhook (gere uma chave aleatória forte)
# Exemplo: python -c "import secrets; print(secrets.token_hex(32))"
WEBHOOK_API_KEY=GERE_UMA_CHAVE_FORTE_AQUI

# Modo apenas triagem (sem busca/listagem de imóveis)
TRIAGE_ONLY=true
