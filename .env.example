# ============================================
# ENVIRONMENT
# ============================================
APP_ENV=production
LOG_LEVEL=INFO

# ============================================
# WHATSAPP CLOUD API (Production)
# ============================================
# OBRIGATÓRIO: Token para verificação do webhook (gere um aleatório seguro)
# Exemplo: openssl rand -hex 32
WHATSAPP_VERIFY_TOKEN=your_verify_token_here

# RECOMENDADO: App Secret para validação de assinatura (X-Hub-Signature-256)
# Obtenha em: https://developers.facebook.com/apps/ → Settings → Basic
WHATSAPP_APP_SECRET=your_app_secret_here

# Para enviar mensagens (quando DISABLE_WHATSAPP_SEND=false)
WHATSAPP_ACCESS_TOKEN=your_access_token_here
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id_here

# Modo teste (permite receber webhooks sem enviar mensagens)
DISABLE_WHATSAPP_SEND=true

# ============================================
# LLM CONFIGURATION (Agente IA)
# ============================================
USE_LLM=true
TRIAGE_ONLY=true

# Opção 1: Gemini (via OpenAI-compatible endpoint)
OPENAI_API_KEY=your_gemini_api_key
OPENAI_MODEL=gemini-2.0-flash-exp
OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/

# Opção 2: Groq (recomendado pela estabilidade)
# GROQ_API_KEY=your_groq_api_key
# GROQ_MODEL=llama-3.3-70b-versatile

# Opção 3: Ollama (local)
# OPENAI_BASE_URL=http://localhost:11434/v1
# OPENAI_MODEL=llama3.2
# OPENAI_API_KEY=ollama

# LLM Timeouts e Tunables
LLM_TIMEOUT=120
# LLM_KEEP_ALIVE=5m
# LLM_NUM_CTX=4096
# LLM_NUM_THREADS=8
# LLM_USE_MMAP=true
# LLM_PREWARM=false

# ============================================
# SERVER
# ============================================
PORT=8000

# ============================================
# FEATURE FLAGS
# ============================================
EXPOSE_AGENT_CONTACT=false
PERSIST_RAW_TEXT=false

# ============================================
# PATHS (Opcional - defaults automáticos)
# ============================================
# LEADS_LOG_PATH=data/leads.jsonl
# LEADS_INDEX_PATH=data/leads_index.json
# EVENTS_PATH=data/events.jsonl
# ROUTING_LOG_PATH=data/routing_log.jsonl
# FOLLOWUP_META_PATH=data/followups.jsonl

# ============================================
# SLA POLICY
# ============================================
# SLA_HOT_THRESHOLD=80
# SLA_WARM_THRESHOLD=50

# ============================================
# QUALITY GATE
# ============================================
# QUALITY_GATE_MIN_SCORE=70
# MAX_QUALITY_GATE_TURNS=3

# ============================================
# DEBUGGING
# ============================================
# CORRELATION_ID=debug-session-id
# QUESTION_SEED=42
